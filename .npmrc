; Only resolve package versions that have been on the registry for at least 3
; days, so a compromised release is caught (and pulled) before it can enter the
; lockfile. It governs resolution (`npm install` / `npm update`); `npm ci` installs
; the lockfile exactly as locked.
;
; Needs npm >= 11.10: older npm ignores this key and says so ("Unknown project
; config"). `devEngines` in package.json flags an npm that is too old.
min-release-age=3